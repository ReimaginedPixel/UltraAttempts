<Project Sdk="Microsoft.NET.Sdk">
  <!-- Applies UltraAttempts' Harmony patches to the real Assembly-CSharp, outside the game: every hook
       must find its method and be accepted. Build the plugin first, then: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == '' And Exists('D:\SteamLibrary\steamapps\common\ULTRAKILL')">D:\SteamLibrary\steamapps\common\ULTRAKILL</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ULTRAKILL</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameDir</_Parameter1>
      <_Parameter2>$(GameDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
